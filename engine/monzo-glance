#!/usr/bin/env bash
# monzo-glance: launcher for the engine behind Monzo Glance, the Monzo bar plugin
# (io.github.silentjay.monzoglance).
#
# The engine and its vendored Monzo client live beside this file:
#     engine/monzoglance/    the engine
#     engine/monzo/          the MIT-licensed Monzo-API 1.3.6 client, pure standard library
# python3 (3.11+) is the only requirement. If it or the package is missing, exec fails, NOTHING
# reaches stdout, and the bar widget paints its broken-link glyph: fail-empty, never
# fail-plausible.
#
#     monzo-glance            the bar tick (one JSON line)      monzo-glance login    sign in
#     monzo-glance --refresh  fetch now                         monzo-glance status   what it knows
SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"     # follow the optional ~/.local/bin symlink
HERE="$(cd "$(dirname "$SOURCE")" && pwd)"
exec env PYTHONPATH="$HERE" python3 -B -m monzoglance.cli "$@"
