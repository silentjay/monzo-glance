#!/usr/bin/env bash
# moth-now: launcher for the engine behind Moth, the Monzo bar plugin (io.github.silentjay.moth).
#
# The engine is a Python package in its own venv, installed by ../install.sh:
#     ~/.local/share/moth-now/mothnow/    the package (a copy of engine/mothnow)
#     ~/.local/share/moth-now/venv/          Python + the pinned, hash-checked Monzo-API client
# This file only starts it. If the venv or the package is missing, exec fails, NOTHING reaches
# stdout, and the bar widget paints its broken-link glyph: fail-empty, never fail-plausible.
#
#     moth-now            the bar tick (one JSON line)      moth-now login    sign in
#     moth-now --refresh  fetch now                         moth-now status   what it knows
HOME_DIR="${MOTH_NOW_HOME:-$HOME/.local/share/moth-now}"
exec env PYTHONPATH="$HOME_DIR" "$HOME_DIR/venv/bin/python" -B -m mothnow.cli "$@"
