#!/usr/bin/env bash
# monzo-glance-open: open Monzo, the way the bar click and the card's "Open Monzo" button do.
#
# One path: Monzo in the default browser. There is no bundled app and no web-app installer.
#
#   monzo-glance-open --print    say what it would do, and open nothing:
#                                "browser <url>"
set -euo pipefail
URL="https://web.monzo.com"

if [[ ${1:-} == "--print" ]]; then
  printf 'browser %s\n' "$URL"
  exit 0
fi
exec xdg-open "$URL"
